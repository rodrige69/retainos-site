{
  "rewrites": [
    { "source": "/onboard", "destination": "/onboard.html" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/promo", "destination": "/promo.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/staff", "destination": "/staff.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/password", "destination": "/password.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/thankyou", "destination": "/thankyou.html" },
    { "source": "/claim", "destination": "/claim.html" },
    { "source": "/claim/:code", "destination": "/claim.html?code=:code" },
    { "source": "/:shop", "destination": "/shop.html?shop=:shop" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" } ] }
  ]
}
